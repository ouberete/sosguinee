ENVIRONMENT=development
DEBUG=True
# Obligatoire en production (le démarrage échoue si absente hors DEBUG)
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

USE_POSTGRES=False
POSTGRES_NAME=sosguinee
POSTGRES_DB=sosguinee
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_CLIENT_DOMAIN=localhost
EMAIL_TIMEOUT=15
SITE_URL=http://localhost:8000

# Adresse interne qui reçoit les messages du formulaire de contact
CONTACT_NOTIFY_EMAIL=

# Djomy (paiements)
DJOMY_CLIENT_ID=change-me
DJOMY_CLIENT_SECRET=change-me
DJOMY_BASE_URL=https://sandbox-api.djomy.africa/v1
DJOMY_WEBHOOK_SECRET=change-me
# Réconciliation des paiements restés "en_attente" (job Celery). Off par défaut.
PAYMENT_RECONCILIATION_ENABLED=False
PENDING_PAYMENT_EXPIRY_HOURS=24
PAYMENT_RECONCILIATION_EVERY_SECONDS=3600
# Plafonnement anti sur-financement à la confirmation. Off par défaut.
DJOMY_ENFORCE_FUNDING_CAP=False

# Stockage des médias (S3 / Object Storage: AWS S3 ou OVH Object Storage)
# USE_S3=False -> stockage disque local (dev). True -> S3 (prod).
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=sosguinee-media          # bucket PUBLIC (images alertes/financements)
AWS_PRIVATE_STORAGE_BUCKET_NAME=sosguinee-private  # bucket PRIVÉ (pièces d'identité)
AWS_S3_REGION_NAME=
# Vide = AWS S3 ; OVH: https://s3.<region>.io.cloud.ovh.net
AWS_S3_ENDPOINT_URL=
# Durée de validité (s) des URLs signées du bucket privé
AWS_QUERYSTRING_EXPIRE=120

# Cache partagé (rate limiting) - obligatoire hors DEBUG
# Par défaut, CELERY_BROKER_URL est utilisé si REDIS_CACHE_URL est vide.
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
# Mettre à True pour tester le cache Redis en dev
USE_REDIS_CACHE=False

# Celery / jobs asynchrones
ASYNC_EMAIL_ENABLED=False
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Cloudflare Turnstile (captcha)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Monitoring
SENTRY_DSN=
